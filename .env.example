# Frontend Environment Variables (for Vite)
# Copy this to .env.local for local development
# Set these in Vercel/Netlify dashboard for production

# API URL - points to your Railway backend
# Example: https://your-app.up.railway.app/api
VITE_API_URL=http://localhost:3001/api

# WebSocket URL - points to your Railway backend
# Example: wss://your-app.up.railway.app
VITE_WS_URL=ws://localhost:3001
